# Copy to /etc/eyelevel-interviews.env on the server (owner root, chmod 600). Never commit real values.
# Akmal generates the real file with:  python3 HR_RECRUITER/booking_site/vps/make_env.py

PORT=3000
# Public address of the site, no trailing slash. Used in every email link and for the logo image.
APP_URL=https://interview.theeyelevelstudio.com

# Google: acts as hr@eyelevelstudio.in (Sheets, Calendar, Gmail send)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
HR_REFRESH_TOKEN=
SHEET_ID=

# ElevenLabs: AI recruiter "Maya"
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Claude: reads and scores each new application
ANTHROPIC_API_KEY=

# Claude model that reads and scores applications (Haiku: fast and cheap)
EXTRACT_MODEL=claude-haiku-4-5

# Password for /api/cron (the 10-minute job). Any long random string.
CRON_SECRET=

# Recruiters get "a new lead has come in" emails only when this is on. PAUSED by Akmal on 5 Oct 2026: keep it off until he says so.
LEAD_EMAILS=off
# Optional. Time one run may spend reading new applications (milliseconds). Use 240000 on the VPS.
INGEST_BUDGET_MS=240000

# Optional: set to 1 to turn off the built-in scheduler and use the system crontab instead
# DISABLE_INTERNAL_CRON=1
