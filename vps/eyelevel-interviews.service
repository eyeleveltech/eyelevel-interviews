[Unit]
Description=EyeLevel interview booking site and AI recruiter API
After=network-online.target
Wants=network-online.target

[Service]
User=eyelevel
Group=eyelevel
WorkingDirectory=/opt/eyelevel-interviews/vps
EnvironmentFile=/etc/eyelevel-interviews.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
